# ─── Required for JSearch (LinkedIn/Indeed/Glassdoor aggregator) ───
# Sign up: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Free tier: 200 requests/month
RAPIDAPI_KEY=

# ─── Required for Daily Email Digest ───
# Must use Gmail App Password, NOT your regular password
# Generate at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification enabled first)
SENDER_EMAIL=
SENDER_APP_PASSWORD=
RECIPIENT_EMAIL=

# ─── Personal identity (kept out of tracked files — .env is gitignored) ───
# Used wherever the active profile leaves candidate_name blank or "[Your Name]"
CANDIDATE_NAME=

# ─── Daily Digest Timing ───
# Multiple send hours (comma-separated, 24h). First hour runs the full
# pipeline (collect + score + email); the rest re-send a digest from the DB.
DAILY_EMAIL_HOURS=9,14,19
# Fallback single hour if DAILY_EMAIL_HOURS is unset
DAILY_EMAIL_HOUR=9
# IANA timezone the hours are interpreted in (e.g. Europe/Zagreb)
DAILY_EMAIL_TIMEZONE=Asia/Kolkata
DAILY_JOBS_COUNT=15

# ─── Collect on startup ───
# Runs a collection when the app boots, unless the last one is fresher
# than the gap below (protects the JSearch quota on restarts)
COLLECT_ON_STARTUP=true
STARTUP_COLLECT_MIN_GAP_HOURS=6

# ─── Optional: Hunter.io (not actively used — LinkedIn search replaces it) ───
HUNTER_API_KEY=

# ─── Optional: Google Sheets Export ───
GOOGLE_SHEETS_CREDS=credentials.json
GOOGLE_SHEET_ID=

# ─── Legacy / Future Use (not used currently) ───
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SERPAPI_KEY=
GROQ_API_KEY=
